# PHP Upload Configuration for Large PDF Files (1GB limit)
# Required for flipbook PDF uploads on GoDaddy hosting
php_value upload_max_filesize 1024M
php_value post_max_size 1024M
php_value max_execution_time 600
php_value max_input_time 600
php_value memory_limit 1024M

RewriteEngine On

# --- 301 Redirects for old Wix links (Added NC flag) ---
